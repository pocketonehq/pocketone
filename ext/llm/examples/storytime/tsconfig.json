{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "skipLibCheck": true
  },
  "include": ["types.d.ts", "pb_hooks/**/*", "pb_migrations/**/*", "pb_pages/**/*"]
}
