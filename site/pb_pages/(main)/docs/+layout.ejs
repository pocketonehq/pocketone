<div class="docs-layout">
  <!-- Desktop sidebar; hidden below 64rem, where the drawer takes over -->
  <aside class="docs-sidebar">
    <div>
      <nav class="docs-nav-scroll" aria-label="Documentation navigation">
        <%
  // the nav this page shows (_private/docs-nav.js)
  const docsNav = ctx.resolve('docs-nav')(ctx)
%>
        <div class="docs-toc-navigation" id="toc" data-nav="<%= docsNav.name %>" data-navs="<%= docsNav.names.join(',') %>"><%- include(docsNav.toc) %></div>
      </nav>
    </div>
  </aside>

  <main class="docs-main">
    <article class="prose">
      <div id="content"><%- slot() %></div>
      <div id="page-footer"><%- ctx.docsFooter() %></div>
    </article>
  </main>
</div>
